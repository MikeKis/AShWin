<?xml version="1.0" encoding="utf-8"?>
<SNN>
  <Global>0.787686</Global>
  <!--NOT USED-->
  <RECEPTORS name="DVS" n="1200">
    <Implementation lib="LightSpotEnvironment"></Implementation>
  </RECEPTORS>
  <RECEPTORS name="Punishment" n="1">
    <Implementation lib="LightSpotEnvironment"></Implementation>
  </RECEPTORS>
  <RECEPTORS name="Reward" n="1">
    <Implementation lib="LightSpotEnvironment"></Implementation>
  </RECEPTORS>
  <RECEPTORS name="Poisson" n="$(NNEU)">
    <Implementation lib="fromFile">
      <args type="none">
        <noise>$(NOISE)</noise>
        <history_length>30000000</history_length>  <!--JUST VERY LONG-->
      </args>
    </Implementation>
  </RECEPTORS>
  <NETWORK>
    <Implementation lib="LightSpot">
      <args>
        <Sections>
          <Section name="L">
            <props>
              <n>$(NNEU)</n> 
              <Structure type="O" dimension="4"></Structure>
              <chartime>$(LCHARTIME)</chartime>
              <threshold_decay_period>$(THRESHOLDDECAYPERIOD)</threshold_decay_period>
              <threshold_inc>$(THRESHOLDINC)</threshold_inc>
              <weight_inc>0</weight_inc>
              <dopamine_plasticity_time>$(PLASTICITYTIME)</dopamine_plasticity_time>
              <maxweight>$(MAXINPUTWEIGHT)</maxweight>
              <migration>SAME_PLACE</migration>
              <!--Inside sub-section!-->
            </props>
          </Section>
          <Section name="SENSORYGATE">
            <props>
              <n>$(NNEU)</n>
              <chartime>$(SENSORYGATECHARTIME)</chartime>
            </props>
          </Section>
          <Section name="GATEREW">
            <props>
              <n>4</n>
              <!--4 directions-->
              <Structure type="O" dimension="4"></Structure>
              <chartime>$(GATECHARTIME)</chartime>
              <threshold_decay_period>$(GATETHRESHOLDDECAYPERIOD)</threshold_decay_period>
              <threshold_inc>$(GATETHRESHOLDINC)</threshold_inc>
            </props>
          </Section>
          <Section name="GATEPUN">
            <props>
              <n>4</n>
              <!--4 directions-->
              <Structure type="O" dimension="4"></Structure>
              <chartime>$(GATECHARTIME)</chartime>
              <threshold_decay_period>$(GATETHRESHOLDDECAYPERIOD)</threshold_decay_period>
              <threshold_inc>$(GATETHRESHOLDINC)</threshold_inc>
            </props>
          </Section>
          <Link from="DVS" to="L" type="plastic">
		  <IniResource type="uni">
		    <min>$(INIINPUTRESOURCE)</min>
		    <max>$(INIINPUTRESOURCE)</max>
		  </IniResource>
		  <probability>$(INPUTPROBABILITY)</probability>
          </Link>
          <Link from="DVS" to="SENSORYGATE" policy="all-to-all">
          	<weight>-$(INPGATEWEIGHT)</weight>
          </Link>
          <Link from="Poisson" to="SENSORYGATE" policy="aligned">
		  <weight>10</weight>
          </Link>
          <Link from="Punishment" to="GATEPUN" policy="all-to-all">
          	<weight>10</weight>
          </Link>
          <Link from="Reward" to="GATEREW" policy="all-to-all">
          	<weight>10</weight>
          </Link>
          <Link from="L" to="GATEREW" type="gating" policy="aligned">
            <weight>$(ACTIVATIONTIME)</weight>
          </Link>
          <Link from="L" to="GATEPUN" type="gating" policy="aligned">
            <weight>$(ACTIVATIONTIME)</weight>
          </Link>
          <Link from="GATEREW" to="L" type="reward" policy="aligned">
            <weight>1</weight>
          </Link>
          <Link from="GATEPUN" to="L" type="reward" policy="aligned">
            <weight>-$(RELPUNEFFECT)</weight>
          </Link>
          <Link from="SENSORYGATE" to="L" policy="aligned">
            <weight>10</weight>
          </Link>
        </Sections>
      </args>
    </Implementation>
  </NETWORK>
  <Readout lib="LightSpotEnvironment">
    <output>L</output>
  </Readout>
</SNN>  
